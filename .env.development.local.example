# ==================================================================
# travel_admin 本機開發 HTTPS 設定範例
# 使用方式：複製此檔案並重命名為 .env.development.local
# 填入您本機產生的 localhost.pem 與 localhost-key.pem 絕對路徑
# ==================================================================

# Local HTTPS 憑證檔案路徑（憑證檔案應存放在 repository 外部）
LOCAL_HTTPS_CERT_PATH = C:\Users\YourUsername\.local-https\localhost.pem
LOCAL_HTTPS_KEY_PATH = C:\Users\YourUsername\.local-https\localhost-key.pem

# ==================================================================
# travel_admin 環境變數設定範例
# ==================================================================

# 應用程式標題
VITE_GLOB_APP_TITLE = 旅遊管理後台

# 本機執行連接埠 (Port)
VITE_PORT = 8848

# 啟動時是否自動開啟瀏覽器
VITE_OPEN = false

# 是否開啟 Vue DevTools 偵錯工具
VITE_DEVTOOLS = false

# 打包後是否生成套件分析報告 (stats.html)
VITE_REPORT = false

# 是否開啟 CodeInspector 點擊源碼跳轉功能
VITE_CODEINSPECTOR = false

# ------------------------------------------------------------------
# 環境與路由設定
# ------------------------------------------------------------------
# 執行環境：development | production | test
VITE_USER_NODE_ENV = development

# 公共基礎路徑 (Public Path)
VITE_PUBLIC_PATH = /

# 路由模式：hash | history
VITE_ROUTER_MODE = hash

# 打包時是否清除 console
VITE_DROP_CONSOLE = true

# 是否開啟 Vite PWA
VITE_PWA = false

# ------------------------------------------------------------------
# 後端 API 與代理設定
# ------------------------------------------------------------------
# 後端 API 基礎位址
VITE_API_URL = https://localhost:8080

# 開發環境跨域代理 (格式為 JSON 二維陣列，如 [["/api", "https://localhost:8080"]])
VITE_PROXY = []

# ------------------------------------------------------------------
# 本機 HTTPS 憑證設定 (請設定於 .env.development.local，勿提交至 Git)
# ------------------------------------------------------------------
# LOCAL_HTTPS_CERT_PATH = C:\Users\YourUsername\.local-https\localhost.pem
# LOCAL_HTTPS_KEY_PATH = C:\Users\YourUsername\.local-https\localhost-key.pem
